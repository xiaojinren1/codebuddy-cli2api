# ── CodeBuddy gateway configuration ──────────────────────────────────────────
# Copy this file to the repository root as `.env`. The gateway loads it
# automatically when you run `python3 -m codebuddy_gateway` from this directory.

# REQUIRED: one or more CodeBuddy API keys (ck_...).
# Get one from the CodeBuddy CLI login (https://www.codebuddy.cn/).
CODEBUDDY_API_KEY=ck_yourkeyid.yoursecret

# Keep local startup deterministic and avoid an unexpected daily check-in.
CODEBUDDY_AUTO_CHECKIN=0

# macOS Python installations may need the system CA bundle for HTTPS.
SSL_CERT_FILE=/etc/ssl/cert.pem

# Bypass proxy interception for the CodeBuddy China endpoint and local gateway.
NO_PROXY=www.codebuddy.cn,.codebuddy.cn,127.0.0.1,localhost
no_proxy=www.codebuddy.cn,.codebuddy.cn,127.0.0.1,localhost

# Local-only gateway defaults.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# OPTIONAL: multiple keys for cache-aware rotation. Comma- or newline-separated.
# The gateway routes by prompt-prefix affinity (same prefix -> same key, warm
# cache) and assigns new prefixes to the key with the highest cache-hit rate,
# tie-broken by fewest requests (even distribution).
# CODEBUDDY_API_KEYS=ck_key1id.secret1,ck_key2id.secret2

# OPTIONAL: load keys from a file (one per line, # comments allowed).
# CODEBUDDY_KEYS_FILE=/path/to/keys.txt

# OPTIONAL: CodeBuddy backend. Defaults to the China deployment (keys starting
# with ck_ are issued by www.codebuddy.cn). The .ai host rejects ck_ keys.
# CODEBUDDY_BASE_URL=https://www.codebuddy.cn

# OPTIONAL: gateway listen address.
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8787

# OPTIONAL: default model for requests that omit one.
# CODEBUDDY_DEFAULT_MODEL=hy3
# Optional Codex/CC Switch display-name aliases. Comma-separated key=value.
# CODEBUDDY_MODEL_ALIASES=gpt-5.6-sol=glm-5.3,gpt-5.6-luna=kimi-k3-2,gpt-5.6-terra=deepseek-v4-flash

# ── Adding a newly released model ──────────────────────────────────────────
# The gateway resolves its model list at runtime (see load_model_catalog in
# codebuddy_gateway/common.py), so most new models appear WITHOUT a code edit:
#
#   1. CODEBUDDY_MODELS_URL       remote JSON list, wins over everything else
#   2. ~/.codebuddy/local_storage the CLI's account-specific live catalog
#   3. the CLI's bundled product.json
#   4. the bundled MODELS constant (hardcoded fallback)
#
# The catalog is cached for CODEBUDDY_MODELS_TTL seconds (default 1h), so after
# the CLI updates you may just need to wait out the TTL (or restart the gateway).
#
# Hand-edit code only when the upstream service accepts a model that the CLI
# catalog has not learned about yet. Verify it is actually routable:
#
#   curl -s localhost:8787/v1/chat/completions -H 'content-type: application/json' \
#     -d '{"model":"<slug>","messages":[{"role":"user","content":"hi"}],"max_tokens":5}'
#
# A working slug returns HTTP 200; an unknown one returns
# "model [<slug>] service info not found (HTTP 400)".
#
# Once confirmed, append the model to models.extra.json (repository root) and
# save. No restart and no TTL wait: the gateway invalidates its catalog cache
# when that file's mtime changes, so the next request sees it. The file's
# _comment block documents every accepted field.
#
# Precedence for duplicate ids is live catalog > models.extra.json > the
# bundled _CATALOG_EXTRAS constant, and each layer skips ids it already has.
# So promoting a model into the CLI later needs no cleanup in either file.
#
# Add the id to _CODEX_REASONING_LEVELS in codebuddy_gateway/common.py only if
# you also want a Codex effort picker menu for it.
#
# OPTIONAL: relocate the supplement file. Defaults to ./models.extra.json;
# set to a path to move it, or to an empty value to disable the layer.
# CODEBUDDY_MODELS_EXTRA_FILE=/path/to/models.extra.json

# OPTIONAL: how Codex system instructions are sent to CodeBuddy. "compact"
# avoids upstream content filtering of Codex's internal prompt (default).
# Use "full" only for compatibility diagnostics; "drop" omits the system message.
# CODEBUDDY_CODEX_INSTRUCTIONS_MODE=compact

# OPTIONAL: explicit CodeBuddy -> Codex model catalog JSON (or a JSON file path).
# Codex does not learn model abilities from /v1/models; expose this structured
# catalog through `python3 -m codebuddy_gateway --print-codex-models`. This
# variable is only a gateway-side override; Codex itself uses
# `model_catalog_json` in `~/.codex/config.toml`.
# CODEBUDDY_MODEL_CATALOG_JSON=/path/to/model_catalog.json

# OPTIONAL: default reasoning injection for clients that omit an effort.
# Valid values are low, high, or an explicit disable: none/off/minimal.
# CODEBUDDY_REASONING_EFFORT=high

# OPTIONAL: auxiliary MCP consultation tool (native Codex remains the only
# component allowed to execute commands). The MCP server calls this gateway.
# CODEBUDDY_CONSULT_MODEL=glm-5.3
# CODEBUDDY_GATEWAY_URL=http://127.0.0.1:8787
# CODEBUDDY_GATEWAY_KEY=

# OPTIONAL: shared secret clients must present (in Authorization: Bearer,
# x-api-key, x-goog-api-key, or ?key=). If unset, no client auth (localhost only).
# GATEWAY_API_KEY=

# OPTIONAL: upstream timeout (seconds) and image fetch size cap (bytes).
# CODEBUDDY_TIMEOUT=180
# IMAGE_FETCH_MAX_BYTES=20971520

# ── OAuth resource endpoints (search / speech / images / videos / check-in) ──
# These need the account's OAuth session, not a ck_ key. The gateway reads the
# session file and refreshes it automatically; clients never see a token.
# CODEBUDDY_AUTH_FILE=/path/to/workbuddy-desktop.info
#   (default: newest of the WorkBuddy desktop and CodeBuddy CLI auth files)

# Upstream for resource endpoints. Defaults to copilot.tencent.com (the
# WorkBuddy desktop endpoint; www.codebuddy.ai rejects the OAuth token with a
# 401). Chat stays on CODEBUDDY_BASE_URL (.cn).
# CODEBUDDY_RESOURCE_BASE_URL=https://copilot.tencent.com

# Expose the gateway to other machines (bind 0.0.0.0). REQUIRES GATEWAY_API_KEY
# or the gateway refuses to start. Default off - the gateway only listens on
# 127.0.0.1; reach it from other machines via an SSH tunnel instead.
# CODEBUDDY_REMOTE=1

# Claim the daily check-in credit (100/day) automatically once per UTC day,
# independent of any client. Set to 0 to disable.
# CODEBUDDY_AUTO_CHECKIN=1
